# Deployer private key (NEVER commit the real key). Prefer `--account <keystore>`
# or `--ledger` over --private-key so the key never lands in shell history.
DEPLOYER_PRIVATE_KEY=0x...

# RPC endpoints
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ── CommissionVault deploy (script/Deploy.s.sol) ──
# Ethereum Mainnet USDC: 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDC_ADDRESS=
DISTRIBUTOR_ADDRESS=
OPERATOR_ADDRESS=
GUARDIAN_ADDRESS=
MAX_CODE_DELTA=
MAX_BATCH_DELTA=
# Optional (defaults: 86400s timelocks, not a migration target)
IS_MIGRATION_TARGET=false
SETTLEMENT_TIMELOCK=86400
PAYOUT_TIMELOCK=86400

# ── RateLimitedForwarder deploy (script/DeployRateLimitedForwarder.s.sol) ──
# The script refuses to broadcast unless the chain id matches and the owner and
# recipient both have code on the target chain.
FORWARDER_CHAIN_ID=1
FORWARDER_TOKEN=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
FORWARDER_RECIPIENT=
FORWARDER_OWNER=
# Token-bucket drip: dripRate tokens accrue per dripPeriod seconds, capped at
# maxReserve (all in the token's smallest unit). Set FORWARDER_DRIP_RATE=0 to
# disable the limit and sweep the full balance (FORWARDER_DRIP_PERIOD may then be 0).
FORWARDER_DRIP_RATE=
FORWARDER_DRIP_PERIOD=
FORWARDER_MAX_RESERVE=
